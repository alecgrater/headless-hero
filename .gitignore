# Data
# Deny everything under data/, then re-include only the curated visual identity.
# New files are ignored by default, so db.sqlite (plaintext API keys) and project
# renders can never be committed by accident. Each directory level needs its own
# negation — git will not descend into an excluded directory.
# This block must stay above the .DS_Store rule below (gitignore is last-match-wins).
/data/**
!/data/identity.json
!/data/style/
!/data/style/**
data/style/**/debug_*
!/data/character/
!/data/character/frames/
!/data/character/frames/**
!/data/character/references/
!/data/character/references/**
!/data/character/thumbnail_references/
!/data/character/thumbnail_references/**
!/data/character/manifest.json
!/data/character/reference_selection.json
!/data/projects/
!/data/projects/asset-vault/
!/data/projects/asset-vault/**
backend/data/

# Superpowers brainstorm sessions
.superpowers/

# Claude worktrees
.claude/worktrees/
.worktrees/

# Test scratch files
test.html
test.js
test2.js
test3.js
test_transform.html

# Env
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Electron
release/
